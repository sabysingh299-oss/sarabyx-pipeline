# Optional. Most people only need an API key in the UI (Settings).
# Copy to .env if you want env-based defaults:  cp .env.example .env

POSTER_PORT=3920
POSTER_BASE_URL=http://127.0.0.1:3920

# Optional AI defaults (OpenAI-compatible). Prefer Settings in the UI.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

BRAND_VOICE="Clear, practical, founder tone. Short sentences. No hype. No emojis."
DEFAULT_HASHTAGS="#buildinpublic #automation"

LINKEDIN_TARGET=profile
LINKEDIN_COMPANY_NAME=

# Optional n8n (not required for the Pipeline UI)
N8N_PORT=5678
GENERIC_TIMEZONE=UTC
TZ=UTC

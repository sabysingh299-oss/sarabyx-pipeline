{
  "name": "02 · Publish Approved Posts",
  "nodes": [
    {
      "parameters": {},
      "id": "b1111111-1111-1111-1111-111111111111",
      "name": "When clicking ‘Test workflow’",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "b2222222-2222-2222-2222-222222222222",
      "name": "Every 10 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 500]
    },
    {
      "parameters": {
        "url": "={{ ($env.POSTER_BASE_URL || 'http://host.docker.internal:3920') + '/approved' }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b3333333-3333-3333-3333-333333333333",
      "name": "Get Approved Rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 400]
    },
    {
      "parameters": {
        "jsCode": "const rows = items[0].json.rows || [];\nif (!rows.length) {\n  return [{ json: { empty: true, message: 'No Approved rows' } }];\n}\nreturn rows.map((row) => ({ json: row }));"
      },
      "id": "b4444444-4444-4444-4444-444444444444",
      "name": "Split Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.empty }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notTrue"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b5555555-5555-5555-5555-555555555555",
      "name": "Has Rows?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [980, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.POSTER_BASE_URL || 'http://host.docker.internal:3920') + '/post' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"id\": \"{{ $json.id }}\"\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "b6666666-6666-6666-6666-666666666666",
      "name": "Browser Post Instagram + LinkedIn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1220, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "result",
              "value": "={{ $json }}",
              "type": "object"
            },
            {
              "id": "s2",
              "name": "logged",
              "value": "Sheet updated with Posted / Failed",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b7777777-7777-7777-7777-777777777777",
      "name": "Result Logged",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1460, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s3",
              "name": "message",
              "value": "No Approved rows right now",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b8888888-8888-8888-8888-888888888888",
      "name": "Nothing to Publish",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1220, 520]
    }
  ],
